es":"55","fr":"55","de":"55","pt":"55"},{"id":"p056","it":"56","en":"56","es":"56","fr":"56","de":"56","pt":"56"},{"id":"p057","it":"57","en":"57","es":"57","fr":"57","de":"57","pt":"57"},{"id":"p058","it":"58","en":"58","es":"58","fr":"58","de":"58","pt":"58"},{"id":"p059","it":"59","en":"59","es":"59","fr":"59","de":"59","pt":"59"},{"id":"p060","it":"60","en":"60","es":"60","fr":"60","de":"60","pt":"60"},{"id":"p061","it":"Forza soldato, fammi vedere cosa sai fare!","en":"Come on soldier, show me what you've got!","es":"¡Vamos soldado, enséñame de qué eres capaz!","fr":"Allez soldat, montre-moi ce que tu vaux !","de":"Los, Soldat, zeig mir, was du kannst!","pt":"Vamos, soldado, mostre do que é capaz!"},{"id":"p062","it":"Testa alta, petto in fuori. Si comincia!","en":"Head up, chest out. Here we go!","es":"Cabeza alta, pecho fuera. ¡Empezamos!","fr":"Tête haute, poitrine en avant. C'est parti !","de":"Kopf hoch, Brust raus. Es geht los!","pt":"Cabeça erguida, peito para fora. Vamos começar!"},{"id":"p063","it":"Nessuna scusa oggi. Via!","en":"No excuses today. Go!","es":"Hoy no hay excusas. ¡Ya!","fr":"Pas d'excuses aujourd'hui. Go !","de":"Keine Ausreden heute. Los!","pt":"Sem desculpas hoje. Já!"},{"id":"p064","it":"Concentrato. Ogni ripetizione conta!","en":"Focus. Every rep counts!","es":"Concentrado. ¡Cada repetición cuenta!","fr":"Concentré. Chaque répétition compte !","de":"Konzentration. Jede Wiederholung zählt!","pt":"Concentrado. Cada repetição conta!"},{"id":"p065","it":"Così si fa!","en":"That's how it's done!","es":"¡Así se hace!","fr":"C'est comme ça qu'on fait !","de":"So wird's gemacht!","pt":"É assim que se faz!"},{"id":"p066","it":"Bravo, continua!","en":"Good, keep going!","es":"¡Bien, sigue!","fr":"Bien, continue !","de":"Gut, weiter!","pt":"Boa, continue!"},{"id":"p067","it":"Non fermarti adesso!","en":"Don't stop now!","es":"¡No te pares ahora!","fr":"Ne t'arrête pas maintenant !","de":"Hör jetzt nicht auf!","pt":"Não pare agora!"},{"id":"p068","it":"Questo è il ritmo giusto!","en":"That's the right pace!","es":"¡Ese es el ritmo!","fr":"C'est le bon rythme !","de":"Genau das richtige Tempo!","pt":"Esse é o ritmo certo!"},{"id":"p069","it":"Sei più forte di quanto pensi!","en":"You're stronger than you think!","es":"¡Eres más fuerte de lo que crees!","fr":"Tu es plus fort que tu ne le crois !","de":"Du bist stärker, als du denkst!","pt":"Você é mais forte do que pensa!"},{"id":"p070","it":"Il dolore passa, l'orgoglio resta!","en":"Pain fades, pride stays!","es":"¡El dolor pasa, el orgullo queda!","fr":"La douleur passe, la fierté reste !","de":"Der Schmerz vergeht, der Stolz bleibt!","pt":"A dor passa, o orgulho fica!"},{"id":"p071","it":"Spingi, soldato!","en":"Push, soldier!","es":"¡Empuja, soldado!","fr":"Pousse, soldat !","de":"Drück, Soldat!","pt":"Força, soldado!"},{"id":"p072","it":"Ottima forma, avanti!","en":"Great form, keep going!","es":"¡Muy buena técnica, adelante!","fr":"Excellente forme, continue !","de":"Saubere Technik, weiter!","pt":"Ótima execução, em frente!"},{"id":"p073","it":"Metà fatta! Adesso viene il bello!","en":"Halfway there! Now the fun starts!","es":"¡Mitad hecha! ¡Ahora viene lo bueno!","fr":"La moitié ! Maintenant le meilleur arrive !","de":"Halbzeit! Jetzt wird's spannend!","pt":"Metade feita! Agora vem a parte boa!"},{"id":"p074","it":"Sei a metà strada. Non mollare!","en":"You're halfway. Don't give up!","es":"Vas por la mitad. ¡No te rindas!","fr":"Tu es à mi-chemin. Ne lâche rien !","de":"Du hast die Hälfte. Nicht aufgeben!","pt":"Você está na metade. Não desista!"},{"id":"p075","it":"Ultime tre! Dai tutto!","en":"Last three! Give it everything!","es":"¡Últimas tres! ¡Dalo todo!","fr":"Les trois dernières ! Donne tout !","de":"Die letzten drei! Gib alles!","pt":"Últimas três! Dê tudo!"},{"id":"p076","it":"Tre alla fine! Stringi i denti!","en":"Three to go! Grit your teeth!","es":"¡Quedan tres! ¡Aprieta los dientes!","fr":"Plus que trois ! Serre les dents !","de":"Noch drei! Zähne zusammenbeißen!","pt":"Faltam três! Cerre os dentes!"},{"id":"p077","it":"Ultima! Tutto quello che hai!","en":"Last one! Everything you've got!","es":"¡La última! ¡Todo lo que tienes!","fr":"La dernière ! Tout ce que tu as !","de":"Die letzte! Alles, was du hast!","pt":"A última! Tudo o que você tem!"},{"id":"p078","it":"L'ultima è la più importante. Spingi!","en":"The last one matters most. Push!","es":"La última es la más importante. ¡Empuja!","fr":"La dernière est la plus importante. Pousse !","de":"Die letzte ist die wichtigste. Drück!","pt":"A última é a mais importante. Força!"},{"id":"p079","it":"Non mollare! Su!","en":"Don't quit! Come on!","es":"¡No te rindas! ¡Vamos!","fr":"Ne lâche pas ! Allez !","de":"Nicht aufgeben! Los!","pt":"Não desista! Vamos!"},{"id":"p080","it":"Avanti, non ti ho detto di riposare!","en":"Move it, I didn't tell you to rest!","es":"¡Vamos, no te he dicho que descanses!","fr":"Allez, je ne t'ai pas dit de te reposer !","de":"Weiter, ich habe nicht gesagt, dass du Pause machen sollst!","pt":"Vamos, eu não mandei descansar!"},{"id":"p081","it":"Rialzati e continua!","en":"Get up and keep going!","es":"¡Levántate y sigue!","fr":"Relève-toi et continue !","de":"Steh auf und mach weiter!","pt":"Levante e continue!"},{"id":"p082","it":"Respira e spingi! Ancora una!","en":"Breathe and push! One more!","es":"¡Respira y empuja! ¡Una más!","fr":"Respire et pousse ! Encore une !","de":"Atme und drück! Noch eine!","pt":"Respire e empurre! Mais uma!"},{"id":"p083","it":"Il traguardo è vicino, muoviti!","en":"The finish is close, move it!","es":"¡La meta está cerca, muévete!","fr":"L'arrivée est proche, bouge-toi !","de":"Das Ziel ist nah, beweg dich!","pt":"A chegada está perto, mexa-se!"},{"id":"p084","it":"Chi molla adesso? Non tu!","en":"Who quits now? Not you!","es":"¿Quién se rinde ahora? ¡Tú no!","fr":"Qui abandonne maintenant ? Pas toi !","de":"Wer gibt jetzt auf? Du nicht!","pt":"Quem desiste agora? Você não!"},{"id":"p085","it":"Tieni duro!","en":"Hang in there!","es":"¡Aguanta!","fr":"Tiens bon !","de":"Halte durch!","pt":"Aguente firme!"},{"id":"p086","it":"Addome di ferro, non cedere!","en":"Iron core, don't give in!","es":"¡Abdomen de hierro, no cedas!","fr":"Abdos d'acier, ne lâche pas !","de":"Bauch aus Stahl, nicht nachgeben!","pt":"Abdômen de ferro, não ceda!"},{"id":"p087","it":"Il corpo vuole fermarsi, la testa no!","en":"Your body wants to stop, your mind doesn't!","es":"¡El cuerpo quiere parar, la cabeza no!","fr":"Le corps veut s'arrêter, la tête non !","de":"Der Körper will aufhören, der Kopf nicht!","pt":"O corpo quer parar, a cabeça não!"},{"id":"p088","it":"Respira. Resisti!","en":"Breathe. Hold on!","es":"Respira. ¡Resiste!","fr":"Respire. Résiste !","de":"Atme. Halte durch!","pt":"Respire. Resista!"},{"id":"p089","it":"Serie completata! Ottimo lavoro, soldato!","en":"Set complete! Great work, soldier!","es":"¡Serie completada! ¡Buen trabajo, soldado!","fr":"Série terminée ! Excellent travail, soldat !","de":"Satz geschafft! Starke Arbeit, Soldat!","pt":"Série concluída! Ótimo trabalho, soldado!"},{"id":"p090","it":"Questo è lo spirito! Serie chiusa!","en":"That's the spirit! Set done!","es":"¡Ese es el espíritu! ¡Serie cerrada!","fr":"Voilà l'esprit ! Série bouclée !","de":"So ist's richtig! Satz erledigt!","pt":"Esse é o espírito! Série fechada!"},{"id":"p091","it":"Bravo! Un passo più vicino al prossimo grado!","en":"Well done! One step closer to the next rank!","es":"¡Bien! ¡Un paso más cerca del próximo grado!","fr":"Bravo ! Un pas de plus vers le prochain grade !","de":"Gut gemacht! Ein Schritt näher am nächsten Rang!","pt":"Muito bem! Um passo mais perto da próxima patente!"},{"id":"p092","it":"Respira. Recupera. Tra poco si riparte.","en":"Breathe. Recover. We go again soon.","es":"Respira. Recupera. Enseguida seguimos.","fr":"Respire. Récupère. On repart bientôt.","de":"Atme. Erhol dich. Gleich geht's weiter.","pt":"Respire. Recupere. Logo recomeçamos."},{"